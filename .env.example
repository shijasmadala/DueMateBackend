# Copy this file to .env and adjust if your local Postgres settings differ.
# Do not put real passwords in git. Postgres.app often needs no password locally.
#
# Format: postgresql+psycopg://USERNAME[:PASSWORD]@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://shijasmadala@localhost:5432/duemate

# Set true only when you want SQLAlchemy to print SQL in the terminal.
DB_ECHO=false
